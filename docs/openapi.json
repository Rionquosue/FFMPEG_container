          },
          "instance_id": {
            "type": "string"
          },
          "operations": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "codecs": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "limits": {
            "type": "object",
