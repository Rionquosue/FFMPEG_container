  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Input": {
        "type": "object",
        "properties": {
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1099511627776
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        },
        "required": [
          "size_bytes",
          "sha256"
        ],
        "additionalProperties": false
      },
      "TranscodeRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "transcode"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096,
                "multipleOf": 2
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096,
                "multipleOf": 2
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover"
                ],
                "default": "contain"
              },
              "quality": {
                "type": "integer",
                "minimum": 18,
                "maximum": 35
              },
              "audio_bitrate_kbps": {
                "type": "integer",
                "minimum": 64,
                "maximum": 320
              },
              "audio_mode": {
                "type": "string",
                "enum": [
                  "preserve",
                  "remove"
                ],
                "default": "preserve",
                "description": "remove drops every audio stream; the output is verified to contain none."
              },
              "max_dimension": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096,
                "multipleOf": 2,
                "description": "Longest edge of the output after auto-rotation. Aspect ratio is kept, nothing is padded and the source is never upscaled. Cannot be combined with width and height."
              },
              "max_fps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Frame-rate ceiling. Applied only when the source is faster; never raises the frame rate."
              },
              "max_bitrate_kbps": {
                "type": "integer",
                "minimum": 100,
                "maximum": 20000,
                "description": "Capped CRF video bitrate (mp4 output only)."
              }
            },
            "required": [],
            "additionalProperties": false,
            "dependentRequired": {
              "width": [
                "height"
              ],
              "height": [
                "width"
              ]
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "max_dimension",
                    "width"
                  ]
                },
                {
                  "required": [
                    "max_dimension",
                    "height"
                  ]
                }
              ]
            }
          },
          "output_format": {
            "type": "string",
            "enum": [
              "mp4",
              "webm"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "output_format": {
              "const": "webm"
            }
          },
          "required": [
            "output_format"
          ]
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "required": [
                  "max_bitrate_kbps"
                ]
              }
            }
          }
        }
      },
      "ResizeRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "resize"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover"
                ],
                "default": "contain"
              },
              "jpeg_quality": {
                "type": "integer",
                "minimum": 50,
                "maximum": 95,
                "default": 85,
                "description": "JPEG output only; invalid_parameter with png."
              }
            },
            "required": [
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpg",
              "png"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false
      },
      "ThumbnailRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "thumbnail"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover"
                ],
                "default": "contain"
              },
              "timestamp_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "jpeg_quality": {
                "type": "integer",
                "minimum": 50,
                "maximum": 95,
                "default": 85,
                "description": "JPEG output only; invalid_parameter with png."
              }
            },
            "required": [
              "width",
              "height",
              "timestamp_seconds"
            ],
            "additionalProperties": false
          },
          "output_format": {
            "type": "string",
            "enum": [
              "jpg",
              "png"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false
      },
      "ExtractAudioRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "extract_audio"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "audio_bitrate_kbps": {
                "type": "integer",
                "minimum": 64,
                "maximum": 320
              },
              "channels": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "output_format": {
            "type": "string",
            "enum": [
              "m4a",
              "mp3",
              "opus"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false
      },
      "TrimRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "trim"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "start_seconds": {
                "type": "number",
                "minimum": 0,
                "maximum": 86400
              },
              "duration_seconds": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 86400
              },
              "quality": {
                "type": "integer",
                "minimum": 18,
                "maximum": 35
              },
              "width": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096,
                "multipleOf": 2
              },
              "height": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096,
                "multipleOf": 2
              },
              "fit": {
                "type": "string",
                "enum": [
                  "contain",
                  "cover"
                ],
                "default": "contain"
              },
              "audio_bitrate_kbps": {
                "type": "integer",
                "minimum": 64,
                "maximum": 320
              },
              "audio_mode": {
                "type": "string",
                "enum": [
                  "preserve",
                  "remove"
                ],
                "default": "preserve",
                "description": "remove drops every audio stream; the output is verified to contain none."
              },
              "max_dimension": {
                "type": "integer",
                "minimum": 16,
                "maximum": 4096,
                "multipleOf": 2,
                "description": "Longest edge of the output after auto-rotation. Aspect ratio is kept, nothing is padded and the source is never upscaled. Cannot be combined with width and height."
              },
              "max_fps": {
                "type": "integer",
                "minimum": 1,
                "maximum": 60,
                "description": "Frame-rate ceiling. Applied only when the source is faster; never raises the frame rate."
              },
              "max_bitrate_kbps": {
                "type": "integer",
                "minimum": 100,
                "maximum": 20000,
                "description": "Capped CRF video bitrate (mp4 output only)."
              }
            },
            "required": [
              "start_seconds",
              "duration_seconds"
            ],
            "additionalProperties": false,
            "dependentRequired": {
              "width": [
                "height"
              ],
              "height": [
                "width"
              ]
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "max_dimension",
                    "width"
                  ]
                },
                {
                  "required": [
                    "max_dimension",
                    "height"
                  ]
                }
              ]
            }
          },
          "output_format": {
            "type": "string",
            "enum": [
              "mp4",
              "webm"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "output_format": {
              "const": "webm"
            }
          },
          "required": [
            "output_format"
          ]
        },
        "then": {
          "properties": {
            "parameters": {
              "not": {
                "required": [
                  "max_bitrate_kbps"
                ]
              }
            }
          }
        }
      },
      "RemuxRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "remux"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {
              "audio_mode": {
                "type": "string",
                "enum": [
                  "preserve",
                  "remove"
                ],
                "default": "preserve",
                "description": "remove drops every audio stream; the output is verified to contain none."
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "output_format": {
            "type": "string",
            "enum": [
              "mp4",
              "webm"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false
      },
      "MetadataRequest": {
        "type": "object",
        "properties": {
          "operation": {
            "type": "string",
            "const": "metadata"
          },
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parameters": {
            "type": "object",
            "properties": {},
            "required": [],
            "additionalProperties": false
          },
          "output_format": {
            "type": "string",
            "enum": [
              "json"
            ]
          }
        },
        "required": [
          "operation",
          "input",
          "parameters",
          "output_format"
        ],
        "additionalProperties": false
      },
      "Request": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TranscodeRequest"
          },
          {
            "$ref": "#/components/schemas/ResizeRequest"
          },
          {
            "$ref": "#/components/schemas/ThumbnailRequest"
          },
          {
            "$ref": "#/components/schemas/ExtractAudioRequest"
          },
          {
            "$ref": "#/components/schemas/TrimRequest"
          },
          {
            "$ref": "#/components/schemas/RemuxRequest"
          },
          {
            "$ref": "#/components/schemas/MetadataRequest"
          }
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          },
          "request_id": {
            "type": "string"
          }
        },
        "required": [
