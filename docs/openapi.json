              "type": "string",
              "default": "application/json"
            }
          },
          {
            "in": "header",
            "name": "If-None-Match",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current state, including failed processing",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              },
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged"
          },
          "400": {
            "description": "Malformed upload, invalid key, checksum or body",
            "content": {
              "application/json": {
                "schema": {
