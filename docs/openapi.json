              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Result"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Error"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "api_version",
          "instance_id",
          "job_id",
          "status",
          "created_at",
          "completed_at",
          "expires_at",
          "status_url",
          "download_url",
          "result",
